{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malapit-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "html_handling": "none", "binding": "ASSETS", "run_worker_first": ["/tutorial/malapit-how-to.mp4"] },
  "vars": { "AUTH_MODE": "supabase", "HITPAY_SANDBOX_BUSINESS_ID": "a344f0b8-a3ef-4b1e-afe4-b6efb9971489" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "malapit-test-db",
    "database_id": "a5b231e4-5a1b-4b30-93fa-ff26280260a6",
    "migrations_dir": "drizzle"
  }]
}
