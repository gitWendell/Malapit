{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malapit-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "html_handling": "none" },
  "vars": { "AUTH_MODE": "access" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "malapit-test-db",
    "database_id": "a5b231e4-5a1b-4b30-93fa-ff26280260a6",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "malapit-test-photos" }]
}
